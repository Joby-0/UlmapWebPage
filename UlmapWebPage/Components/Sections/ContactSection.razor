<section id="contact" class="contact-section section reveal">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Get in <span class="text-gradient">Touch</span></h2>
            <p class="section-subtitle">Let's discuss how we can help your business reach its digital potential.</p>
        </div>
        
        <div class="contact-grid">
            <div class="contact-info">
                <div class="contact-method glass-card">
                    <i class="fa-solid fa-envelope"></i>
                    <div>
                        <h4>Email</h4>
                        <p>hello@ulmap.com</p>
                    </div>
                </div>
                <div class="contact-method glass-card">
                    <i class="fa-solid fa-phone"></i>
                    <div>
                        <h4>Phone</h4>
                        <p>+46 (0) 8 123 45 67</p>
                    </div>
                </div>
                <div class="contact-method glass-card">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <h4>Office</h4>
                        <p>Kungsgatan 1, Stockholm, SE</p>
                    </div>
                </div>
            </div>
            
            <div class="contact-form-container glass-card">
                <form class="contact-form">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" placeholder="Your name" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" placeholder="Your email" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea placeholder="How can we help?" class="form-input" rows="4"></textarea>
                    </div>
                    <button type="submit" class="btn-premium btn-primary-premium w-full">Send Message</button>
                </form>
            </div>
        </div>
    </div>
</section>
