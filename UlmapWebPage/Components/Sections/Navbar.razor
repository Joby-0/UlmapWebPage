            <i class="fa-solid fa-compass logo-icon"></i>
            <span class="logo-text">ULMAP</span>
        </a>

        <div class="navbar-links @(isMenuOpen ? "active" : "")">
            <a href="#home" @onclick="ToggleMenu">Home</a>
